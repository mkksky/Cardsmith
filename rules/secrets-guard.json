{
  "version": 1,
  "description": "密钥防泄守卫的机器规则。patterns 是已知密钥格式（hard=高危阻断，soft=可疑仅提醒）；sensitive_files 是「文件本身被暂存就拦」的清单（按文件名匹配）；soft_var_regex 是敏感变量名赋值的形态启发；allow_values 放行确证无害的示例值；skip_paths 必须把 check_secrets_selftest.py 排除——自检里的假密钥是故意的测试样本。改完跑 --selftest 验证。",
  "patterns": [
    {
      "id": "private-key",
      "severity": "hard",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "why": "私钥文件内容进了代码（RSA/EC/OPENSSH/PGP 私钥块）——换了格式也改不了它是私钥"
    },
    {
      "id": "github-token",
      "severity": "hard",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{30,}\\b",
      "why": "GitHub personal access token 的固定前缀（ghp_/gho_/ghu_/ghs_/ghr_）"
    },
    {
      "id": "aws-akid",
      "severity": "hard",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "why": "AWS access key id 的固定前缀（AKIA + 16 位）"
    },
    {
      "id": "google-api-key",
      "severity": "hard",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "why": "Google API key 的固定前缀（AIza + 35 位）"
    }
  ],
  "sensitive_files": [
    ".env",
    ".env.*",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.kdbx",
    "id_rsa*",
    "*credential*"
  ],
  "soft_var_regex": "(?i)\\b(api[_-]?key|apikey|secret|secret[_-]?key|access[_-]?key|access[_-]?token|auth[_-]?token|passwd|password|passphrase|app[_-]?secret|client[_-]?secret|private[_-]?token)\\b\\s*[=:]\\s*[\"']([^\"']{10,})[\"']",
  "min_length": 10,
  "allow_values": [],
  "allow_files": [],
  "skip_paths": [
    "**/check_secrets_selftest.py",
    "**/.cardsmith/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/baselines/**",
    "**/.git/**"
  ]
}
