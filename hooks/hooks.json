{
  "description": "由 scripts/build.py 从 cards/ 生成，勿手改。改绑定关系请改卡片后重跑 build。",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" ahk-v2",
            "description": "校验 .ahk 脚本是否用了 AutoHotkey v2 语法",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" protected-paths",
            "description": "阻断受保护路径（迁移脚本等）下的任何暂存变更",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" dead-code",
            "description": "检查暂存文件的 require 绑定使用情况与全仓库导出引用计数",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" doc-sync",
            "description": "查文档引用路径、API 符号，以及可选的新增文件文档覆盖",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" size-naming",
            "description": "检查文件行数与文件名命名规范",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" format-lint",
            "description": "调用本机已装的 ruff / ruff-format / eslint，统一到套件退出码",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" import-direction",
            "description": "用 AST 解析各层文件的导入，判断是否违反分层依赖方向",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" module-contracts",
            "description": "检查内部解构 require 请求的成员是否由目标模块真实导出",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" perf-smells",
            "description": "阻断档：列表 key 用下标、循环内 setData、forEach+async、睡眠等异步",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" debug-smells",
            "description": "抓裸 except / except-pass / 空 catch 等吞错误的写法",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" secrets",
            "description": "扫描暂存文件里的私钥、云厂商 token、密钥形态赋值；高危阻断，可疑仅提醒",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"${CODEBUDDY_PROJECT_DIR}/hooks/run.py\" stale-imports",
            "description": "解析导入说明符，校验目标模块在仓库内真实存在",
            "timeout": 15
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
