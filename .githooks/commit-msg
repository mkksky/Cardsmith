#!/bin/sh
# commit-msg 门禁 —— 机制与 .githooks/pre-commit 完全相同，差异只有两点：
#   1. 时机：message 写完之后、提交对象生成之前（pre-commit 时 message 还不存在）
#   2. git 会把 message 文件路径作为 $1 传进来，原样转给执行体
# 版本化存放与解释器选择的理由见 .githooks/pre-commit 头注释，不在此重复。

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

RUNNER=""
for cand in "$ROOT/scripts/run_precommit.py" "$ROOT/.codingskills/scripts/run_precommit.py"; do
  if [ -f "$cand" ]; then
    RUNNER="$cand"
    break
  fi
done

if [ -z "$RUNNER" ]; then
  echo "commit-msg: 找不到 run_precommit.py，跳过检查"
  exit 0
fi

PY=""

pick() {
  [ -n "$PY" ] && return 0
  [ -n "$1" ] || return 0
  if command -v "$1" >/dev/null 2>&1; then
    "$1" -c 'import sys' >/dev/null 2>&1 && PY="$1"
  elif [ -x "$1" ] && "$1" -c 'import sys' >/dev/null 2>&1; then
    PY="$1"
  fi
  return 0
}

pick "$PRECOMMIT_PYTHON"
pick python3
pick python

if [ -z "$PY" ]; then
  for d in "$HOME"/.workbuddy/binaries/python/versions/*/python.exe; do
    [ -x "$d" ] && "$d" -c 'import sys' >/dev/null 2>&1 && PY="$d"
  done
fi

if [ -z "$PY" ]; then
  echo "commit-msg: 未找到可用的 Python 解释器，跳过检查"
  exit 0
fi

"$PY" "$RUNNER" commit-msg "$1"
RC=$?

# ── 链式接力：宿主钩子 ──
# 机制见 .githooks/pre-commit 尾部注释。commit-msg 要把 message 文件路径透传。
if [ "$RC" -eq 0 ] && [ -f "$ROOT/.githooks/legacy-hook" ]; then
  LEGACY=$(sed -n 's/.*"commit-msg"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.githooks/legacy-hook")
  if [ -n "$LEGACY" ] && [ -f "$ROOT/$LEGACY" ]; then
    if [ -x "$ROOT/$LEGACY" ]; then
      ( cd "$ROOT" && "./$LEGACY" "$1" )
    else
      ( cd "$ROOT" && sh "$LEGACY" "$1" )
    fi
    RC=$?
  fi
fi
exit $RC
